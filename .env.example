# Copy to `.env` and adjust. Every variable is optional for local development.

# DATABASE_URL=postgresql+psycopg://examable:examable@localhost:5432/examable
# UPLOAD_DIR=uploads
# MAX_UPLOAD_MB=25

# Protects uploads, processing, AI jobs and /admin/* with the X-Admin-Token header.
# Always set it on a public deployment.
# ADMIN_TOKEN=change-me

# Optional LLM features (any OpenAI-compatible endpoint).
# MULTIMODAL_ENABLED=true
# MULTIMODAL_API_KEY=sk-...
# MULTIMODAL_API_BASE_URL=https://api.openai.com/v1
# MULTIMODAL_MODEL=gpt-4.1-mini
# MULTIMODAL_MIN_QUALITY=0.72
# MULTIMODAL_MAX_PAGES=8
# CORRECTION_GEN_MODEL=
